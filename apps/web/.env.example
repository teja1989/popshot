# Copy to .env.local for local development. Never commit real values.
# The Firebase web config is public by design, but keep real project IDs out of the repo.
API_BASE_URL=http://127.0.0.1:8000
# Set only on Cloud Run: the API service URL, used as the audience of the service identity token.
API_AUDIENCE=
FIREBASE_API_KEY=replace-me
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=replace-me
